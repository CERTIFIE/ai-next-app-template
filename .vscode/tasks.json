{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docker: up",
      "type": "shell",
      "command": "docker compose --env-file .env -f .docker/compose.app.yml up -d --build",
      "problemMatcher": []
    },
    {
      "label": "docker: down",
      "type": "shell",
      "command": "docker compose --env-file .env -f .docker/compose.app.yml down",
      "problemMatcher": []
    },
    {
      "label": "docker: logs app",
      "type": "shell",
      "command": "docker compose --env-file .env -f .docker/compose.app.yml logs -f app",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "test: all",
      "type": "shell",
      "command": "sh .docker/test.sh all",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
