# Copia in .env e personalizza:  cp .env.example .env
# .env non va mai in Git e non viene letto dagli agenti.

# --- progetto
# Nome tecnico: minuscolo, solo lettere, cifre, - e _ (usato come nome progetto Compose)
APP_NAME=myapp
NODE_VERSION=24
DEFAULT_LOCALE=it
SUPPORTED_LOCALES=it,en
APP_URL=http://localhost:3000

# --- porte pubblicate sul loopback dell'host
APP_PORT=3000
DEBUG_PORT=9229
POSTGRES_PORT=5432
MAILDEV_WEB_PORT=1080
MAILDEV_SMTP_PORT=1025
SONAR_PORT=9000

# --- hot reload: metti true se le modifiche non vengono rilevate nel container
WATCHPACK_POLLING=false

# --- PostgreSQL (sviluppo)
POSTGRES_VERSION=17
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
# Dentro Docker l'app usa l'host "postgres"; questa riga serve agli strumenti sull'host.
DATABASE_URL=postgresql://app:change-me@localhost:5432/app

# --- autenticazione (Better-Auth)
# Genera con: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- posta: MailDev in sviluppo (http://localhost:1080)
SMTP_HOST=maildev
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="MyApp <no-reply@example.com>"

# --- job pianificati (/api/cron/*) — genera con: openssl rand -hex 32
CRON_SECRET=

# --- API pubbliche /api/v1
API_RATE_LIMIT_PER_MINUTE=120

# --- storage file (in sviluppo: .data/storage montata su /storage)
STORAGE_DIR=/storage

# --- SonarQube (http://localhost:9000)
SONARQUBE_VERSION=community
SONAR_DB=sonar
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar
SONAR_TOKEN=

# --- immagini di supporto
MAILDEV_VERSION=latest
SONAR_SCANNER_VERSION=latest
# Deve coincidere con la versione di @playwright/test
PLAYWRIGHT_VERSION=v1.56.0
